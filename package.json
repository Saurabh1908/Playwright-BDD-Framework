{
  "name": "playwright-bdd-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Beginner-friendly Cucumber BDD automation with Playwright and TypeScript",
  "scripts": {
    "test:bdd": "tsx test-runner/runner.ts",
    "test:bdd:html": "tsx test-runner/runner.ts",
    "test:bdd:headed": "cross-env HEADED=true tsx test-runner/runner.ts",
    "test:bdd:smoke": "cross-env TAGS=@smoke tsx test-runner/runner.ts",
    "test:bdd:e2e": "cross-env TAGS=@e2e tsx test-runner/runner.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@types/node": "^22.13.0",
    "cross-env": "^7.0.3",
    "cucumber-html-reporter": "^7.2.0",
    "dotenv": "^16.4.7",
    "playwright": "^1.51.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}