{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM"],
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["config/**/*.ts", "hooks/**/*.ts", "pages/**/*.ts", "step-definitions/**/*.ts", "support/**/*.ts", "test-runner/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "dist", "reports", "screenshots"]
}